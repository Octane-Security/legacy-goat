      "results": [
        {
          "ruleId": "sql-injection",
          "level": "error",
          "message": {
            "text": "LG-SQLI-001: SQL injection in the single-query staff sign-on (SIGNON-BY-QUERY)"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "cobol/staffauth.cbl"
                },
                "region": {
                  "startLine": 76,
                  "endLine": 89
                }
              }
            }
          ],
          "properties": {
            "id": "LG-SQLI-001",
            "cwe": 89,
            "class": "sql-injection",
            "module": "cobol",
            "language": "COBOL",
            "status": "exploitable",
            "exploitable": true,
            "detectable": true,
            "gate": {
              "config": "session_roaming=on"
            }
          }
        },
        {
          "ruleId": "business-logic",
          "level": "error",
          "message": {
            "text": "LG-BIZ-001: Negative-amount transfer reverses the money flow (missing positive-amount check)"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "cobol/postxfer.cbl"
                },
                "region": {
                  "startLine": 85,
                  "endLine": 86
                }
              }
            }
          ],
          "properties": {
