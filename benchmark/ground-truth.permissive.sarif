            "language": "Fortran",
            "status": "exploitable",
            "exploitable": true,
            "detectable": true,
            "gate": {
              "data": "amount large enough to overflow int32 cents"
            }
          }
        },
        {
          "ruleId": "improper-output-encoding",
          "level": "error",
          "message": {
