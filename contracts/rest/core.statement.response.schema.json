{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "core.statement.response.schema.json",
  "title": "Core account statement response (COBOL adapter -> gateway)",
  "description": "Marshals from STATEMENT-REPLY in copybook/core-ops.cpy: the account's ten most recent ledger lines, newest first. lines is empty unless result is OK.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "account_id",
    "result",
    "lines"
  ],
  "properties": {
    "account_id": {
      "$ref": "common.schema.json#/$defs/AccountId"
    },
    "result": {
      "$ref": "common.schema.json#/$defs/OpResult"
    },
    "reason": {
      "$ref": "common.schema.json#/$defs/Description"
    },
    "currency": {
      "$ref": "common.schema.json#/$defs/Currency"
    },
    "balance": {
      "$ref": "common.schema.json#/$defs/Money"
    },
    "lines": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "$ref": "common.schema.json#/$defs/StatementLine"
      }
    }
  }
}
