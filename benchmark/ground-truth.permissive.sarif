              }
            },
            {
              "id": "dli-ssa-injection",
              "name": "dli-ssa-injection",
              "properties": {
                "cwe": 943
              }
            },
            {
              "id": "out-of-bounds-read",
              "name": "out-of-bounds-read",
              "properties": {
