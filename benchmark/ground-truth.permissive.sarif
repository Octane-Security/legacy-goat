            "status": "exploitable",
            "exploitable": true,
            "detectable": true,
            "gate": {
              "config": "report_archive=on"
            }
          }
        },
        {
          "ruleId": "broken-authentication",
          "level": "error",
          "message": {
            "text": "LG-AUTH-001: Weak, forgeable self-describing session token (no entropy, no server-side session)"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "pascal/console.pas"
                },
                "region": {
                  "startLine": 413,
