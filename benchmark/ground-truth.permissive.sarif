            "language": "COBOL",
            "status": "exploitable",
            "exploitable": true,
            "detectable": true,
            "gate": null
          }
        },
        {
          "ruleId": "broken-access-control",
          "level": "error",
          "message": {
            "text": "LG-AC-001: Config-gated branch-scope bypass (IDOR) in the core post-transfer"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "cobol/postxfer.cbl"
                },
                "region": {
                  "startLine": 166,
