            "status": "exploitable",
            "exploitable": true,
            "detectable": true,
            "gate": {
              "config": "session_roaming=on"
            }
          }
        },
        {
          "ruleId": "numeric-overflow",
          "level": "error",
          "message": {
            "text": "LG-NUM-001: Integer overflow in the fee calculation (32-bit nint on a large amount)"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "fortran/riskfee.f90"
                },
                "region": {
