{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "core.post-transfer.request.schema.json",
  "title": "Core post-transfer request (gateway -> COBOL adapter)",
  "description": "Marshals to TRANSFER-REQUEST in copybook/transfer-io.cpy plus the actor + threshold context.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "transfer_id",
    "from_account",
    "to_account",
    "amount",
    "currency",
    "requested_by",
    "requested_at",
    "actor",
    "require_approval_over"
  ],
  "properties": {
    "transfer_id": {
      "$ref": "common.schema.json#/$defs/TransferId"
    },
    "from_account": {
      "$ref": "common.schema.json#/$defs/AccountId"
    },
    "to_account": {
      "$ref": "common.schema.json#/$defs/AccountId"
    },
    "amount": {
      "$ref": "common.schema.json#/$defs/Money"
    },
    "currency": {
      "$ref": "common.schema.json#/$defs/Currency"
    },
    "requested_by": {
      "$ref": "common.schema.json#/$defs/CustomerId"
    },
    "requested_at": {
      "$ref": "common.schema.json#/$defs/Timestamp"
    },
    "actor": {
      "$ref": "common.schema.json#/$defs/Actor"
    },
    "require_approval_over": {
      "$ref": "common.schema.json#/$defs/Money"
    }
  }
}
