{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "core.cash.response.schema.json",
  "title": "Core teller cash response (COBOL adapter -> gateway)",
  "description": "Marshals from CASH-REPLY in copybook/core-ops.cpy.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "transfer_id",
    "status"
  ],
  "properties": {
    "transfer_id": {
      "$ref": "common.schema.json#/$defs/TransferId"
    },
    "status": {
      "type": "string",
      "enum": [
        "POSTED",
        "REJECTED"
      ]
    },
    "reason": {
      "$ref": "common.schema.json#/$defs/Description"
    },
    "account_posting": {
      "$ref": "common.schema.json#/$defs/PostingId"
    },
    "cash_posting": {
      "$ref": "common.schema.json#/$defs/PostingId"
    },
    "cash_account": {
      "$ref": "common.schema.json#/$defs/AccountId"
    },
    "balance": {
      "$ref": "common.schema.json#/$defs/Money"
    }
  }
}
