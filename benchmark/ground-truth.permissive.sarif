{
  "$schema": "https://raw.githubusercontent.com/oasis-tcs/sarif-spec/master/Schemata/sarif-schema-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "legacy-goat-ground-truth",
          "informationUri": "https://github.com/legacy-goat",
          "version": "1",
          "properties": {
            "profile": "permissive"
          },
          "rules": [
            {
              "id": "sql-injection",
              "name": "sql-injection",
              "properties": {
                "cwe": 89
              }
            },
            {
              "id": "business-logic",
              "name": "business-logic",
              "properties": {
                "cwe": 840
              }
            },
            {
              "id": "broken-access-control",
              "name": "broken-access-control",
              "properties": {
                "cwe": 862
              }
            },
            {
              "id": "os-command-injection",
              "name": "os-command-injection",
              "properties": {
                "cwe": 78
              }
            },
            {
              "id": "broken-authentication",
              "name": "broken-authentication",
              "properties": {
                "cwe": 384
              }
            },
            {
              "id": "numeric-overflow",
              "name": "numeric-overflow",
              "properties": {
                "cwe": 190
              }
            },
            {
              "id": "improper-output-encoding",
              "name": "improper-output-encoding",
              "properties": {
                "cwe": 116
              }
            },
            {
              "id": "path-traversal",
              "name": "path-traversal",
              "properties": {
                "cwe": 22
              }
            },
            {
              "id": "hardcoded-secret",
              "name": "hardcoded-secret",
              "properties": {
                "cwe": 760
              }
            },
            {
              "id": "sensitive-data-logging",
              "name": "sensitive-data-logging",
              "properties": {
                "cwe": 532
              }
            },
            {
              "id": "server-side-request-forgery",
              "name": "server-side-request-forgery",
              "properties": {
